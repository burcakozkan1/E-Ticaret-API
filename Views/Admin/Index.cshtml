@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B&O Atelier - Admin Yönetim Paneli</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Great Vibes (Signature Script Logo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">

    <style>
        body { 
            background-color: #ffffff; 
            font-family: sans-serif; 
            color: #2b2d42;
        }
        
        .brand-logo {
            font-family: 'Great Vibes', cursive;
            font-size: 2.4rem !important;
            color: #d4af37 !important;
            letter-spacing: 1px;
            font-weight: normal;
        }

        .admin-card {
            border: 1px solid rgba(128, 0, 32, 0.15);
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .btn-bordo {
            background-color: #800020;
            color: #d4af37;
            font-weight: 600;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-bordo:hover {
            background-color: #5c0017;
            color: #ffffff;
        }

        .table-bordo th {
            background-color: #800020;
            color: #d4af37;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg border-bottom shadow-sm py-2 mb-4" style="background-color: #800020;">
        <div class="container">
            <a class="navbar-brand brand-logo d-flex align-items-center" href="/">
                B&O Atelier <span class="fs-6 ms-3 text-light fw-sans-serif" style="font-family: sans-serif;">(Admin Yönetim Paneli)</span>
            </a>
            <div class="navbar-nav ms-auto align-items-center">
                <a class="nav-link px-3 text-light" href="/">
                    <i class="bi bi-shop me-1"></i> Mağazaya Dön
                </a>
                <a class="nav-link px-3" style="color: #d4af37;" href="#" id="logoutBtn">
                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                </a>
            </div>
        </div>
    </nav>

    <!-- Admin İçerik Alanı -->
    <div class="container my-5">
        <div class="row g-4">
            
            <!-- Sol Kolon: Kategoriye Göre Ürün Ekleme Formu -->
            <div class="col-lg-5">
                <div class="card admin-card p-4">
                    <h4 class="fw-bold mb-3" style="color: #800020;">
                        <i class="bi bi-plus-circle-fill me-2" style="color: #d4af37;"></i>Yeni Ürün Ekle
                    </h4>
                    <p class="text-muted small mb-4">Mağaza kataloğuna yeni bir ürün ekleyin.</p>

                    <form id="addProductForm">
                        <!-- Ürün Adı -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: #800020;">Ürün Adı</label>
                            <input type="text" id="productName" class="form-control py-2" placeholder="Örn: Siyah Deri Ceket" required>
                        </div>

                        <!-- Kategori Seçimi -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: #800020;">Kategori Seçin</label>
                            <select id="productCategory" class="form-select py-2" required>
                                <option value="" selected disabled>Kategori Seçiniz...</option>
                                <option value="Ayakkabı">Ayakkabı</option>
                                <option value="Çanta">Çanta</option>
                                <option value="Ceket">Ceket</option>
                                <option value="Elbise">Elbise</option>
                            </select>
                        </div>

                        <!-- Fiyat -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: #800020;">Fiyat (TL)</label>
                            <input type="number" step="0.01" id="productPrice" class="form-control py-2" placeholder="1850.00" required>
                        </div>

                        <!-- Görsel Adı / Yolu -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold" style="color: #800020;">Görsel Dosya Adı / Yolu</label>
                            <input type="text" id="productImage" class="form-control py-2" placeholder="Örn: ceket1.jpg veya /images/ceket1.jpg">
                            <span class="form-text text-muted small">wwwroot/images klasöründeki görsel adını yazabilirsiniz.</span>
                        </div>

                        <!-- Kaydet Butonu -->
                        <button type="submit" class="btn btn-bordo w-100 py-3 rounded-pill shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Ürünü Yayınla
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sağ Kolon: Eklenen Ürünler Listesi -->
            <div class="col-lg-7">
                <div class="card admin-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold m-0" style="color: #800020;">
                            <i class="bi bi-bag-check-fill me-2" style="color: #d4af37;"></i>Mevcut Ürünler
                        </h4>
                        <span class="badge rounded-pill px-3 py-2" style="background-color: #800020; color: #d4af37;" id="productCount">0 Ürün</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-bordo">
                                <tr>
                                    <th>Görsel</th>
                                    <th>Ürün Adı</th>
                                    <th>Kategori</th>
                                    <th>Fiyat</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="adminProductTable">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Ürünler yükleniyor...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- JavaScript & API Mantığı -->
    <script>
        const API_URL = '/api/products';

        document.addEventListener('DOMContentLoaded', () => {
            // Güvenlik Kontrolü: Admin olmayan erişemez
            const userRole = localStorage.getItem('userRole');
            if (userRole !== 'admin') {
                alert('Bu sayfaya erişim yetkiniz bulunmamaktadır.');
                window.location.href = '/';
                return;
            }

            loadAdminProducts();
        });

        // Çıkış Yap
        document.getElementById('logoutBtn').addEventListener('click', (e) => {
            e.preventDefault();
            localStorage.clear();
            window.location.href = '/';
        });

        // Ürünleri Çekme ve Tabloya Yazma
        async function loadAdminProducts() {
            try {
                const res = await fetch(API_URL);
                const products = await res.json();
                const tbody = document.getElementById('adminProductTable');
                const countBadge = document.getElementById('productCount');
                
                tbody.innerHTML = '';

                if (!products || products.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Henüz eklenmiş ürün bulunmuyor.</td></tr>';
                    countBadge.textContent = '0 Ürün';
                    return;
                }

                countBadge.textContent = products.length + ' Ürün';

                products.forEach(p => {
                    let imgPath = p.imagePath || p.ImagePath || '';
                    if (!imgPath) {
                        imgPath = '/images/elbise1.jpg';
                    } else if (!imgPath.startsWith('/') && !imgPath.startsWith('http')) {
                        imgPath = '/' + imgPath;
                    }

                    tbody.innerHTML += `
                        <tr>
                            <td><img src="${imgPath}" width="45" height="45" class="rounded object-fit-cover shadow-sm"></td>
                            <td class="fw-bold" style="color: #800020;">${p.name || p.Name}</td>
                            <td>
                                <span class="badge border" style="background-color: #f8f9fa; color: #800020;">
                                    ${p.category || p.Category || 'Genel'}
                                </span>
                            </td>
                            <td class="fw-bold" style="color: #d4af37;">${p.price || p.Price} TL</td>
                            <td class="text-end">
                                <button onclick="deleteProduct(${p.id || p.Id})" class="btn btn-sm btn-outline-danger rounded-circle" title="Ürünü Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
            } catch (err) {
                console.error('Ürünler çekilirken hata oluştu:', err);
            }
        }

        // Yeni Ürün Ekleme Formu
        document.getElementById('addProductForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const newProduct = {
                name: document.getElementById('productName').value.trim(),
                category: document.getElementById('productCategory').value,
                price: parseFloat(document.getElementById('productPrice').value),
                imagePath: document.getElementById('productImage').value.trim()
            };

            try {
                const res = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(newProduct)
                });

                if (res.ok) {
                    alert('Ürün başarıyla eklendi!');
                    document.getElementById('addProductForm').reset();
                    loadAdminProducts();
                } else {
                    alert('Ürün eklenirken bir hata oluştu.');
                }
            } catch (err) {
                console.error('Hata:', err);
            }
        });

        // Ürün Silme
        async function deleteProduct(id) {
            if (!confirm('Bu ürünü silmek istediğinize emin misiniz?')) return;

            try {
                const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    loadAdminProducts();
                } else {
                    alert('Silme işlemi başarısız.');
                }
            } catch (err) {
                console.error('Silme hatası:', err);
            }
        }
    </script>
</body>
</html>
