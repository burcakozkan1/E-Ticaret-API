@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B&O Atelier - Mağaza</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts: Great Vibes (Signature Script Logo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">

    <style>
        body { 
            background-color: #ffffff; 
            font-family: sans-serif; 
            color: #2b2d42;
        }
        
        .brand-logo {
            font-family: 'Great Vibes', cursive;
            font-size: 2.4rem !important;
            color: #d4af37 !important;
            letter-spacing: 1px;
            font-weight: normal;
        }

        .hero-banner {
            background: #800020;
            color: #ffffff;
            border-radius: 20px;
            padding: 3rem 2rem;
            margin-bottom: 2.5rem;
            box-shadow: 0 4px 15px rgba(128, 0, 32, 0.2);
        }

        .dropdown:hover .dropdown-menu {
            display: block;
            margin-top: 0;
        }

        .dropdown-menu {
            border: 1px solid rgba(128, 0, 32, 0.15);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 10px;
        }

        .dropdown-item:hover {
            background-color: #800020;
            color: #d4af37 !important;
        }

        .btn-filter {
            color: #800020;
            border-color: #800020;
            font-weight: 600;
        }

        .btn-filter:hover, .btn-filter.active {
            background-color: #800020;
            color: #d4af37 !important;
            border-color: #800020;
        }

        .product-card {
            border: 1px solid rgba(128, 0, 32, 0.15);
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            overflow: hidden;
            height: 100%;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(128, 0, 32, 0.15);
            border-color: #800020;
        }

        .product-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .btn-add-cart {
            background-color: #800020;
            color: #d4af37;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            width: 100%;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn-add-cart:hover {
            background-color: #5c0017;
            color: #ffffff;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg border-bottom shadow-sm py-2 mb-4" style="background-color: #800020;">
        <div class="container">
            <a class="navbar-brand brand-logo d-flex align-items-center" href="/">
                B&O Atelier <i class="bi bi-bag-heart-fill ms-2" style="font-size: 1.2rem;"></i>
            </a>
            <div class="navbar-nav ms-auto align-items-center" id="navMenu">
                <a class="nav-link px-3 active fw-bold text-light" href="/">Anasayfa</a>
                <a class="nav-link px-3" style="color: #d4af37;" href="/Cart">Sepetim</a>
                
                <!-- Admin Başlığı  -->
                <span id="adminMenuItem"></span>

                <a class="nav-link px-3 text-light" id="authLink" href="/Account/Login">Giriş Yap</a>
                <a class="btn ms-2 px-4 rounded-pill fw-bold shadow-sm" id="registerBtn" style="background-color: #d4af37; color: #800020;" href="/Account/Register">Kayıt Ol -></a>
            </div>
        </div>
    </nav>

    <!-- Ana İçerik / Hero Banner -->
    <div class="container my-4">
        <!-- Banner (Ortada: Koleksiyonu Keşfet) -->
        <div class="hero-banner text-center text-md-start">
            <h1 class="fw-bold mb-3" style="color: #d4af37;">Koleksiyonu Keşfet</h1>
            <p class="lead opacity-90 mb-4">B&O Atelier ayrıcalıklarına erişin, size özel koleksiyonları ve avantajlı fırsatları kaçırmayın.</p>
            <a class="btn px-4 py-2 fw-bold rounded-pill shadow-sm" style="background-color: #d4af37; color: #800020; border: none;" href="/Account/Register">Kayıt Ol -></a>
        </div>

        <!-- Filtre ve Kategori Seçenekleri -->
        <div class="d-flex justify-content-end align-items-center mb-4">
            <div class="btn-group" role="group" aria-label="Kategori Filtreleme">
                
                <button type="button" class="btn btn-filter active px-4">Tümü</button>

                <div class="btn-group dropdown" role="group">
                    <button type="button" class="btn btn-filter dropdown-toggle px-4" data-bs-toggle="dropdown" aria-expanded="false">
                        Kategori
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end py-2">
                        <li><a class="dropdown-item py-2 fw-semibold" style="color: #800020;" href="#">Ayakkabı</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" style="color: #800020;" href="#">Çanta</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" style="color: #800020;" href="#">Ceket</a></li>
                        <li><a class="dropdown-item py-2 fw-semibold" style="color: #800020;" href="#">Elbise</a></li>
                    </ul>
                </div>

                <button type="button" class="btn btn-filter px-4">Öne Çıkanlar</button>

            </div>
        </div>

        <!-- Ürünler Grid Alanı -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="productList">
            <div class="col-12 text-center py-5">
                <div class="spinner-border" style="color: #800020;" role="status">
                    <span class="visually-hidden">Ürünler Yükleniyor...</span>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const API_URL = '/api/products';

        document.addEventListener('DOMContentLoaded', () => {
            checkAuthStatus();
            loadProducts();
        });

        // Oturum ve Admin Başlığı Kontrolü
        function checkAuthStatus() {
            const userRole = localStorage.getItem('userRole');
            const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';

            const adminMenuItem = document.getElementById('adminMenuItem');
            const authLink = document.getElementById('authLink');
            const registerBtn = document.getElementById('registerBtn');

            if (isLoggedIn) {
                
                authLink.textContent = 'Çıkış Yap';
                authLink.href = '#';
                authLink.onclick = (e) => {
                    e.preventDefault();
                    localStorage.clear();
                    window.location.reload();
                };

                registerBtn.style.display = 'none'; 

                
                if (userRole === 'admin') {
                    adminMenuItem.innerHTML = `
                        <a class="nav-link px-3 fw-bold" style="color: #d4af37;" href="/Admin">
                            <i class="bi bi-gear-fill me-1"></i> Admin
                        </a>
                    `;
                }
            }
        }

        async function loadProducts() {
            try {
                const response = await fetch(API_URL);
                const products = await response.json();

                const productList = document.getElementById('productList');
                productList.innerHTML = '';

                if (!products || products.length === 0) {
                    productList.innerHTML = '<div class="col-12"><p class="text-muted text-center">Henüz eklenmiş bir ürün bulunmuyor.</p></div>';
                    return;
                }

                for (let i = 0; i < products.length; i++) {
                    let p = products[i];
                    let path = p.imagePath || p.ImagePath || '';

                    if (!path) {
                        const defaultImages = ['elbise1.jpg', 'elbise2.jpeg', 'elbise3.webp'];
                        let imgName = defaultImages[i % defaultImages.length];
                        path = '/images/' + imgName;
                    }

                    if (!path.startsWith('/') && !path.startsWith('http')) {
                        path = '/' + path;
                    }

                    productList.innerHTML += `
                    <div class="col">
                        <div class="card h-100 shadow-sm product-card">
                            <img src="${path}" class="card-img-top product-img" alt="${p.name || p.Name}">
                            <div class="card-body text-center d-flex flex-column justify-content-between p-3">
                                <div>
                                    <h5 class="card-title fw-bold fs-6" style="color: #800020;">${p.name || p.Name}</h5>
                                    <p class="card-text fw-bold mb-3" style="color: #d4af37;">${p.price || p.Price} TL</p>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary btn-sm w-100 mb-2" style="border-color: #800020; color: #800020;">İncele</button>
                                    <button class="btn btn-add-cart">Sepete Ekle</button>
                                </div>
                            </div>
                        </div>
                    </div>`;
                }
            } catch (error) {
                console.error('Ürünler yüklenirken hata oluştu:', error);
                document.getElementById('productList').innerHTML = '<div class="col-12"><p class="text-danger text-center">Ürünler yüklenirken bir sorun oluştu.</p></div>';
            }
        }
    </script>
</body>
</html>
