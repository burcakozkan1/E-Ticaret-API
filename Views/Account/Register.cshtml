@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopVerse - Kayıt Ol</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body style="background-color: #ffffff; color: #2b2d42;">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg border-bottom shadow-sm py-3 mb-5" style="background-color: #800020;">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" style="color: #d4af37;" href="/Product/Index">
    B&O Atelier <i class="bi bi-bag-heart-fill ms-1"></i>
</a>
            <div class="navbar-nav ms-auto align-items-center">
                <a class="nav-link px-3 text-light" href="/">Anasayfa</a>
                <a class="nav-link px-3" style="color: #d4af37;" href="/Cart">Sepetim</a>
                <a class="nav-link px-3 text-light" href="/Account/Login">Giriş Yap</a>
                <a class="btn ms-2 px-4 rounded-pill fw-bold shadow-sm" style="background-color: #d4af37; color: #800020;" href="/Account/Register">Kayıt Ol -></a>
            </div>
        </div>
    </nav>

    <!-- Form Kartı -->
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card border-0 shadow rounded-4 p-4" style="background-color: #ffffff; border: 1px solid rgba(128, 0, 32, 0.2) !important;">
                    <div class="text-center mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #800020;">
                            <i class="bi bi-person-plus-fill fs-1" style="color: #d4af37;"></i>
                        </div>
                        <h3 class="fw-bold" style="color: #800020;">Aramıza Katılın</h3>
                        <p class="text-muted small">ShopVerse ayrıcalıklarından faydalanmak için hesap oluşturun</p>
                    </div>

                    <form action="/Account/Register" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: #800020;">Ad Soyad</label>
                            <input type="text" class="form-control py-2 bg-light border-0" placeholder="Adınız Soyadınız" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: #800020;">E-Posta Adresi</label>
                            <input type="email" class="form-control py-2 bg-light border-0" placeholder="ornek@email.com" required>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold" style="color: #800020;">Şifre</label>
                            <input type="password" class="form-control py-2 bg-light border-0" placeholder="••••••••" required>
                        </div>

                        <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill shadow-sm mb-3" style="background-color: #d4af37; color: #800020; border: none;">
                            Kayıt Ol ve Katıl ->
                        </button>

                        <div class="text-center">
                            <span class="small text-muted">Zaten hesabınız var mı?</span>
                            <a href="/Account/Login" class="small fw-bold ms-1" style="color: #800020;">Giriş Yap</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</body>
</html>