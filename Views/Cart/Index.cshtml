@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopVerse - Sepetim</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body style="background-color: #ffffff; color: #2b2d42;">

    <!-- Navbar (Bordo Arka Plan, Gold Yazılar) -->
    <!-- Navbar (Bordo Arka Plan, Gold Yazılar) -->
<nav class="navbar navbar-expand-lg border-bottom shadow-sm py-3 mb-4" style="background-color: #800020;">
    <div class="container">
        <!-- Logo Tıklanınca da Anasayfaya Gitmesi İçin Düzeltildi -->
        <a class="navbar-brand fw-bold fs-4" style="color: #d4af37;" href="/Home/Index">
            B&O Atelier <i class="bi bi-bag-heart-fill ms-1"></i>
        </a>
        <div class="navbar-nav ms-auto align-items-center">
            <!-- DÜZELTİLEN KISIM: /Product/Index yerine /Home/Index yazıldı -->
            <a class="nav-link px-3 text-light" href="/Home/Index">Anasayfa</a>
            <a class="nav-link px-3 active fw-bold" style="color: #d4af37;" href="/Cart/Index">Sepetim</a>
        </div>
    </div>
</nav>

    <!-- Sepet Alanı -->
    <div class="container my-5">
        <h2 class="fw-bold mb-4" style="color: #800020;">
            <i class="fas fa-shopping-cart me-2" style="color: #d4af37;"></i>Alışveriş Sepetim
        </h2>

        <div class="row" id="cart-container">
            <!-- Sepet Ürünleri Listesi -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-3" style="background-color: #ffffff; border: 1px solid #800020 !important;">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr style="border-bottom: 2px solid #800020;">
                                    <th style="color: #800020;">Ürün</th>
                                    <th style="color: #800020;">Fiyat</th>
                                    <th style="color: #800020;">Adet</th>
                                    <th style="color: #800020;">Toplam</th>
                                    <th class="text-end" style="color: #800020;">İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items-body">
                                <!-- Dinamik olarak JavaScript dolduracak -->
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Sepetiniz yükleniyor...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Sepet Özeti / Toplam Alanı (Bordo Kutu, Gold Detaylar) -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: #800020; color: #ffffff;">
                    <h4 class="fw-bold mb-3" style="color: #d4af37;">Sipariş Özeti</h4>
                    <hr style="border-color: #d4af37;">

                    <div class="d-flex justify-content-between mb-2 opacity-90">
                        <span>Ara Toplam</span>
                        <span id="subtotal" class="fw-bold" style="color: #d4af37;">0.00 ₺</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 opacity-90">
                        <span>Kargo</span>
                        <span class="fw-bold" style="color: #d4af37;">Ücretsiz</span>
                    </div>

                    <hr style="border-color: #d4af37;">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5 text-white">Toplam</span>
                        <span id="grand-total" class="fw-bold fs-4" style="color: #d4af37;">0.00 ₺</span>
                    </div>

                    <a href="/Checkout/Index" class="btn btn-lg rounded-pill w-100 shadow-sm py-3 fw-bold" style="background-color: #d4af37; color: #800020; border: none;">
                        <i class="fas fa-credit-card me-2"></i>Ödemeye Geç
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sepet Mantığı (JavaScript) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            loadCart();
        });

        function loadCart() {
            // DÜZELTME: Varsayılan elbise verisi kaldırıldı ([] yapıldı)
            let cart = JSON.parse(localStorage.getItem('shopverse_cart')) || [];
            renderCart(cart);
        }

        function renderCart(cartItems) {
            const tbody = document.getElementById('cart-items-body');
            const subtotalEl = document.getElementById('subtotal');
            const grandTotalEl = document.getElementById('grand-total');

            if (!cartItems || cartItems.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-5 text-muted fw-bold">Sepetinizde ürün bulunmamaktadır.</td></tr>';
                subtotalEl.innerText = "0.00 ₺";
                grandTotalEl.innerText = "0.00 ₺";
                return;
            }

            let html = '';
            let total = 0;

            cartItems.forEach(item => {
                let itemTotal = item.price * item.quantity;
                total += itemTotal;

                html += `
                <tr style="border-bottom: 1px solid rgba(128, 0, 32, 0.15);">
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="${item.image || '/images/elbise1.jpg'}" class="rounded-3 me-3" style="width: 60px; height: 60px; object-fit: cover;" alt="">
                            <div>
                                <h6 class="fw-bold mb-0" style="color: #800020;">${item.name}</h6>
                            </div>
                        </div>
                    </td>
                    <td class="fw-semibold" style="color: #800020;">${item.price.toLocaleString()} ₺</td>
                    <td>
                        <div class="input-group input-group-sm" style="width: 100px;">
                            <button class="btn btn-outline-danger" style="border-color: #800020; color: #800020;" onclick="updateQuantity(${item.id}, -1)">-</button>
                            <input type="text" class="form-control text-center bg-light border-0 fw-bold" value="${item.quantity}" readonly>
                            <button class="btn btn-outline-danger" style="border-color: #800020; color: #800020;" onclick="updateQuantity(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td class="fw-bold" style="color: #d4af37;">${itemTotal.toLocaleString()} ₺</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="removeItem(${item.id})">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
            subtotalEl.innerText = total.toLocaleString() + " ₺";
            grandTotalEl.innerText = total.toLocaleString() + " ₺";
        }

        function updateQuantity(id, change) {
            let cart = JSON.parse(localStorage.getItem('shopverse_cart')) || [];
            let item = cart.find(x => x.id === id);
            if (item) {
                item.quantity += change;
                if (item.quantity <= 0) {
                    cart = cart.filter(x => x.id !== id);
                }
                localStorage.setItem('shopverse_cart', JSON.stringify(cart));
                renderCart(cart);
            }
        }

        function removeItem(id) {
            let cart = JSON.parse(localStorage.getItem('shopverse_cart')) || [];
            cart = cart.filter(x => x.id !== id);
            localStorage.setItem('shopverse_cart', JSON.stringify(cart));
            renderCart(cart);
        }
    </script>
</body>
</html>
