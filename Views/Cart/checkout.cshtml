@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopVerse - Ödeme ve Sipariş Tamamlama</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-danger fs-4" href="/Product/Index">ShopVerse 🛍️</a>
            <div class="navbar-nav ms-auto align-items-center">
                <a class="nav-link px-3" href="/Cart/Index">Sepete Geri Dön</a>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <h2 class="fw-bold mb-4"><i class="fas fa-credit-card me-2 text-primary"></i>Sipariş ve Ödeme Bilgileri</h2>

        <form onsubmit="completeOrder(event)">
            <div class="row">
                <!-- Teslimat Bilgileri -->
                <div class="col-lg-7 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h4 class="fw-bold mb-3"><i class="fas fa-map-marker-alt me-2 text-danger"></i>Teslimat Adresi</h4>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Ad</label>
                                <input type="text" class="form-control" required placeholder="Adınız">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Soyad</label>
                                <input type="text" class="form-control" required placeholder="Soyadınız">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">E-Posta</label>
                                <input type="email" class="form-control" required placeholder="ornek@mail.com">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Adres Detayı</label>
                                <textarea class="form-control" rows="3" required placeholder="Mahalle, sokak, bina no, daire..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">İlçe / Semt</label>
                                <input type="text" class="form-control" required placeholder="Örn: Eyüpsultan">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">İl</label>
                                <input type="text" class="form-control" required placeholder="Örn: İstanbul">
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h4 class="fw-bold mb-3"><i class="fas fa-wallet me-2 text-success"></i>Ödeme Yöntemi</h4>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="creditCard" checked>
                            <label class="form-check-label fw-bold" for="creditCard">
                                Kredi / Banka Kartı
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Kart Üzerindeki İsim</label>
                            <input type="text" class="form-control" placeholder="Ad Soyad">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Kart Numarası</label>
                            <input type="text" class="form-control" maxlength="16" placeholder="XXXX XXXX XXXX XXXX">
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold">Son Kullanma Tarihi (Ay/Yıl)</label>
                                <input type="text" class="form-control" placeholder="AA/YY">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold">CVV</label>
                                <input type="text" class="form-control" maxlength="4" placeholder="123">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sipariş Özeti ve Onay Butonu -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h4 class="fw-bold mb-3">Sipariş Özeti</h4>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ara Toplam</span>
                            <span class="fw-bold">450.00 ₺</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Kargo</span>
                            <span class="text-success fw-bold">Ücretsiz</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">Ödenecek Tutar</span>
                            <span class="fw-bold fs-5 text-primary">450.00 ₺</span>
                        </div>
                        <button type="submit" class="btn btn-success btn-lg rounded-pill w-100 shadow-sm py-3 fw-bold">
                            <i class="fas fa-check-circle me-2"></i>Siparişi Onayla ve Tamamla
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script>
        function completeOrder(event) {
            event.preventDefault();
            alert('Siparişiniz başarıyla alındı! Teşekkür ederiz.');
            localStorage.removeItem('shopverse_cart');
            window.location.href = '/Product/Index';
        }
    </script>
</body>
</html>
